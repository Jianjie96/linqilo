.container {
  padding: 30rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 顶部 */
.hero {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.hero-icon {
  display: block;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.hero-sub {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 章节 */
.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #07C160;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 50%;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 概念说明 */
.concept-row {
  display: flex;
  gap: 20rpx;
}

.concept-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.concept-body {
  flex: 1;
}

.concept-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.concept-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.concept-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 24rpx 0;
}

/* 规则列表 */
.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.rule-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07C160;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 提示框 */
.tip-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(7, 193, 96, 0.06);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCC;
}
