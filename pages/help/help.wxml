<view class="container">
  <!-- 欢迎 -->
  <view class="hero">
    <view class="hero-icon icon icon-book-green"></view>
    <text class="hero-title">叮咚到期 · 使用帮助</text>
    <text class="hero-sub">了解组队与视角的核心概念，轻松管理你的物品</text>
  </view>

  <!-- 组队 -->
  <view class="section">
    <view class="section-head">
      <text class="section-num">1</text>
      <text class="section-title">组队</text>
    </view>
    <view class="card">
      <view class="concept-row">
        <view class="concept-icon icon icon-pencil-green"></view>
        <view class="concept-body">
          <text class="concept-title">创建者 = 管理员</text>
          <text class="concept-desc">创建者可以随时修改队伍名称，也可以主动解散队伍（解散后队内数据全部删除）。</text>
        </view>
      </view>
      <view class="concept-divider"></view>
      <view class="concept-row">
        <view class="concept-icon icon icon-handshake-green"></view>
        <view class="concept-body">
          <text class="concept-title">加入 = 成员资格</text>
          <text class="concept-desc">输入邀请码即可加入队伍，查看和操作队伍中的共享数据，也可以同时加入多个队伍。</text>
        </view>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">当队伍里最后一个人退出时，队伍自动解散</text>
      </view>
    </view>
  </view>

  <!-- 切换视角 -->
  <view class="section">
    <view class="section-head">
      <text class="section-num">2</text>
      <text class="section-title">切换视角</text>
    </view>
    <view class="card">
      <view class="concept-row">
        <view class="concept-icon icon icon-eye-green"></view>
        <view class="concept-body">
          <text class="concept-title">数据带视角维度</text>
          <text class="concept-desc">所有操作数据都带上视角：个人视角的数据归个人，队伍视角的数据归队伍。</text>
          <text class="concept-desc">首页顶部下拉可以随时切换视角，切换很快。</text>
        </view>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">个人视角下添加的物品归个人；队伍视角下添加的物品归队伍，队内成员共享</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">切换视角不影响消息推送订阅</text>
      </view>
    </view>
    <view class="tip-box">
      <view class="tip-icon icon icon-bulb-gold"></view>
      <text class="tip-text">类比：视角是你「此刻在哪个空间操作」，切换轻快，不影响任何订阅关系。</text>
    </view>
  </view>

  <!-- 消息推送 -->
  <view class="section">
    <view class="section-head">
      <text class="section-num">3</text>
      <text class="section-title">消息推送</text>
    </view>
    <view class="card">
      <view class="concept-row">
        <view class="concept-icon icon icon-bell-green"></view>
        <view class="concept-body">
          <text class="concept-title">默认订阅</text>
          <text class="concept-desc">创建或加入某个队伍后，默认订阅该队伍的消息推送，无需额外操作。</text>
        </view>
      </view>
      <view class="concept-divider"></view>
      <view class="concept-row">
        <view class="concept-icon icon icon-bell-off-gray"></view>
        <view class="concept-body">
          <text class="concept-title">可手动静音（mute）</text>
          <text class="concept-desc">在「队伍管理」页可以为个人或任一队伍单独静音，静音后不再收到该目标的提醒，随时可以重新开启。</text>
        </view>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">推送消息汇总你所有已订阅（个人和队伍）的数据情况，一条消息看全</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">每天早上 8:00 自动检查临期物品</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">需要先在设置页开启通知授权</text>
      </view>
    </view>
    <view class="tip-box">
      <view class="tip-icon icon icon-bulb-gold"></view>
      <text class="tip-text">个人数据与每支队伍分别是一个订阅目标，各自独立控制。</text>
    </view>
  </view>

  <!-- 退出队伍 -->
  <view class="section">
    <view class="section-head">
      <text class="section-num">4</text>
      <text class="section-title">退出队伍</text>
    </view>
    <view class="card">
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">退出不影响队伍内的数据：在队伍内创建的数据资产归属队伍，退出后留在队伍，队友可继续使用</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">退出后你对该队伍的操作权限将被移除，该队伍的推送订阅也会随之移除</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">若队伍只剩你一人，退出后队伍自动解散，队内数据全部删除</text>
      </view>
    </view>
    <view class="tip-box">
      <view class="tip-icon icon icon-bulb-gold"></view>
      <text class="tip-text">想保留个人数据？在个人视角下添加即可；在队伍内添加的就是队伍的资产。</text>
    </view>
  </view>

  <!-- 排行榜 -->
  <view class="section">
    <view class="section-head">
      <text class="section-num">5</text>
      <text class="section-title">排行榜</text>
    </view>
    <view class="card">
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">排行榜跟着视角走：个人视角看个人排行，队伍视角看队伍排行</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">等级、价值等数据也跟随视角计算</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">「超过全网 xx%」统计所有个人和队伍的数据情况后同台排名</text>
      </view>
    </view>
  </view>

  <!-- 邀请队友 -->
  <view class="section">
    <view class="section-head">
      <text class="section-num">6</text>
      <text class="section-title">邀请队友</text>
    </view>
    <view class="card">
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">创建队伍后获得 6 位邀请码</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">将邀请码发给家人或朋友，对方在「队伍管理」页输入即可加入</text>
      </view>
      <view class="rule-item">
        <text class="rule-dot"></text>
        <text class="rule-text">创建者可以随时刷新邀请码（旧码失效）</text>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">叮咚到期 · 提前记录，临期提醒，重要事情不再忘</text>
  </view>
</view>
