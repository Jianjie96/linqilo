.container {
  padding: 20rpx 30rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 10rpx 16rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 推送订阅 */
.binding-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.binding-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  margin-right: 16rpx;
}

.binding-icon {
  width: 44rpx;
  height: 44rpx;
}

.binding-text {
  display: flex;
  flex-direction: column;
}

.binding-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.binding-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 静音开关（订阅中=绿，已静音=灰） */
.mute-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #07C160;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s;
}

.mute-switch.is-muted {
  background: #D0D0D0;
}

.mute-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: left 0.2s;
}

.mute-switch.is-muted .mute-knob {
  left: 44rpx;
}

/* 创建/加入 */
.input-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.team-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.code-input {
  letter-spacing: 8rpx;
  font-family: monospace;
  text-transform: uppercase;
}

.btn-create {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  text-align: center;
}

.btn-create::after {
  border: none;
}

/* 队伍列表 */
.team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.team-item:last-child {
  border-bottom: none;
}

.team-item-left {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

.team-item-icon {
  width: 38rpx;
  height: 38rpx;
}

.team-item-info {
  display: flex;
  flex-direction: column;
}

.team-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.team-item-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.team-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-btn {
  font-size: 24rpx;
  color: #999;
}

.empty-teams {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 详情弹层 */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.detail-card {
  width: 85%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.detail-title-input {
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
  margin-right: 16rpx;
}

.detail-close {
  width: 40rpx;
  height: 40rpx;
  padding: 6rpx;
}

.detail-section {
  margin-bottom: 28rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.invite-code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-code {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 8rpx;
  font-family: monospace;
}

.invite-copy {
  font-size: 24rpx;
  color: #07C160;
  padding: 6rpx 16rpx;
  border: 2rpx solid #07C160;
  border-radius: 16rpx;
}

.invite-share {
  font-size: 24rpx;
  color: #fff;
  background-color: #07C160;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.invite-refresh {
  font-size: 24rpx;
  color: #FF9500;
  padding: 6rpx 16rpx;
  border: 2rpx solid #FF9500;
  border-radius: 16rpx;
}

.member-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.member-avatar-default {
  background-color: #F0F0F0;
  background-size: 36rpx 36rpx;
}

.member-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  color: #333;
}

.member-badge {
  font-size: 22rpx;
  color: #FF9500;
  margin-left: 12rpx;
}

.detail-actions {
  margin-top: 32rpx;
}

/* 创建者操作行：修改名称 / 解散队伍 */
.detail-action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-secondary,
.btn-dissolve {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: normal;
}

.btn-secondary {
  color: #07C160;
  border: 2rpx solid #07C160;
}

.btn-dissolve {
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
}

.btn-edit-icon {
  width: 32rpx;
  height: 32rpx;
}

.btn-secondary::after,
.btn-dissolve::after {
  border: none;
}

.btn-leave {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  background: #fff;
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: normal;
}

.btn-leave::after {
  border: none;
}
