.container {
  padding: 20rpx 30rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 10rpx 16rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 当前绑定 */
.binding-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.binding-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.binding-icon {
  font-size: 40rpx;
}

.binding-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.binding-switch {
  font-size: 26rpx;
  color: #07C160;
  padding: 8rpx 20rpx;
  border: 2rpx solid #07C160;
  border-radius: 28rpx;
}

/* 创建/加入 */
.input-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.team-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.code-input {
  letter-spacing: 8rpx;
  font-family: monospace;
  text-transform: uppercase;
}

.btn-create {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  text-align: center;
}

.btn-create::after {
  border: none;
}

/* 队伍列表 */
.team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.team-item:last-child {
  border-bottom: none;
}

.team-item-bound {
  background: rgba(7, 193, 96, 0.04);
  margin: 0 -32rpx;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
}

.team-item-left {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

.team-item-icon {
  font-size: 36rpx;
}

.team-item-info {
  display: flex;
  flex-direction: column;
}

.team-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.team-item-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.team-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bound-tag {
  font-size: 22rpx;
  color: #fff;
  background: #07C160;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.bind-btn {
  font-size: 24rpx;
  color: #07C160;
  padding: 6rpx 20rpx;
  border: 2rpx solid #07C160;
  border-radius: 20rpx;
}

.detail-btn {
  font-size: 24rpx;
  color: #999;
}

.empty-teams {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 详情弹层 */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.detail-card {
  width: 85%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.detail-section {
  margin-bottom: 28rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.invite-code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-code {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 8rpx;
  font-family: monospace;
}

.invite-copy {
  font-size: 24rpx;
  color: #07C160;
  padding: 6rpx 16rpx;
  border: 2rpx solid #07C160;
  border-radius: 16rpx;
}

.invite-refresh {
  font-size: 24rpx;
  color: #FF9500;
  padding: 6rpx 16rpx;
  border: 2rpx solid #FF9500;
  border-radius: 16rpx;
}

.member-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.member-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-name {
  font-size: 28rpx;
  color: #333;
}

.member-badge {
  font-size: 22rpx;
  color: #FF9500;
  margin-left: 12rpx;
}

.detail-actions {
  margin-top: 32rpx;
}

.btn-leave {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-leave::after {
  border: none;
}
