<view class="container">
  <!-- 推送订阅（默认订阅个人与全部队伍，可单独静音） -->
  <view class="section-title">推送订阅</view>
  <view class="card binding-card">
    <view class="binding-status">
      <view class="binding-icon icon {{personalMuted ? 'icon-bell-off-gray' : 'icon-bell-green'}}"></view>
      <view class="binding-text">
        <text class="binding-name">{{personalMuted ? '个人空间已静音' : '个人空间推送中'}}</text>
        <text class="binding-hint">推送汇总所有未静音的订阅目标</text>
      </view>
    </view>
    <view class="mute-switch {{personalMuted ? 'is-muted' : ''}}" bindtap="toggleMute" data-target="personal">
      <view class="mute-knob"></view>
    </view>
  </view>

  <!-- 创建队伍 -->
  <view class="section-title">创建队伍</view>
  <view class="card">
    <view class="input-row">
      <input class="team-input" placeholder="输入队伍名称" value="{{newTeamName}}" bindinput="onTeamNameInput" maxlength="20" />
      <button class="btn-create" bindtap="createTeam">创建</button>
    </view>
  </view>

  <!-- 加入队伍 -->
  <view class="section-title">加入队伍</view>
  <view class="card">
    <view class="input-row">
      <input class="team-input code-input" placeholder="输入6位邀请码" value="{{joinCode}}" bindinput="onJoinCodeInput" maxlength="6" />
      <button class="btn-create" bindtap="joinTeam">加入</button>
    </view>
  </view>

  <!-- 我的队伍列表 -->
  <view class="section-title">我的队伍</view>
  <view class="card">
    <!-- 队伍列表 -->
    <block wx:if="{{hasTeams}}">
      <block wx:for="{{teams}}" wx:key="teamId">
        <view class="team-item">
          <view class="team-item-left" bindtap="showTeamDetail" data-team-id="{{item.teamId}}">
            <view class="team-item-icon icon icon-users-dark"></view>
            <view class="team-item-info">
              <text class="team-item-name">{{item.name}}</text>
              <text class="team-item-hint">{{item.memberCount}} 人</text>
            </view>
          </view>
          <view class="team-item-right">
            <view class="mute-switch {{item.isMuted ? 'is-muted' : ''}}" catchtap="toggleMute" data-target="{{item.teamId}}">
              <view class="mute-knob"></view>
            </view>
            <text class="detail-btn" catchtap="showTeamDetail" data-team-id="{{item.teamId}}">详情 ›</text>
          </view>
        </view>
      </block>
    </block>

    <view class="empty-teams" wx:if="{{!hasTeams}}">
      <text class="empty-text">还没有加入任何队伍</text>
    </view>
  </view>

  <!-- 队伍详情弹层 -->
  <view class="detail-overlay" wx:if="{{showDetail}}">
    <view class="detail-card" catchtap="">
      <view class="detail-header">
        <input
          wx:if="{{detailTeam.isCreator}}"
          class="detail-title detail-title-input"
          value="{{detailTeam.name}}"
          maxlength="20"
          bindblur="onRenameBlur"
          bindconfirm="onRenameConfirm"
        />
        <text wx:else class="detail-title">{{detailTeam.name}}</text>
        <view class="detail-close icon icon-close-gray" bindtap="hideTeamDetail"></view>
      </view>

      <!-- 邀请码 -->
      <view class="detail-section">
        <text class="detail-label">邀请码</text>
        <view class="invite-code-row">
          <text class="invite-code">{{detailTeam.inviteCode}}</text>
          <button class="invite-share" open-type="share">邀请</button>
          <text class="invite-copy" bindtap="copyInviteCode">复制</text>
          <text class="invite-refresh" wx:if="{{detailTeam.isCreator}}" bindtap="refreshCode">刷新</text>
        </view>
      </view>

      <!-- 成员列表 -->
      <view class="detail-section">
        <text class="detail-label">成员（{{membersLoading ? '加载中…' : detailMembers.length + '人'}}）</text>
        <view class="member-loading" wx:if="{{membersLoading}}">
          <view class="member-loading-spinner"></view>
          <text>正在加载成员…</text>
        </view>
        <view class="member-list" wx:else>
          <view class="member-item" wx:for="{{detailMembers}}" wx:key="openid">
            <image class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}"></image>
            <view class="member-avatar member-avatar-default icon icon-user-dark" wx:else></view>
            <view class="member-info">
              <text class="member-name">{{item.nickName || (item.isSelf ? '我' : '队员')}}</text>
              <text class="member-badge" wx:if="{{item.isCreator}}">创建者</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="detail-actions">
        <view class="detail-action-row">
          <button class="btn-leave" bindtap="leaveTeam">退出队伍</button>
          <button class="btn-dissolve" wx:if="{{detailTeam.isCreator}}" bindtap="dissolveTeam">解散队伍</button>
        </view>
      </view>
    </view>
  </view>
</view>
