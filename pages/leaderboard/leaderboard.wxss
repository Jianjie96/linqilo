.page-leaderboard {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ── 加载 ── */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #07C160;
  animation: pulse 1.2s ease infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.2; transform: scale(0.6); }
  50% { opacity: 1; transform: scale(1.4); }
}

.loading-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 20rpx;
  letter-spacing: 6rpx;
}

/* ── 主成就区 ── */
.hero {
  position: relative;
  overflow: hidden;
  background: #161618;
  animation: fade 0.5s ease both;
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.hero-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(7, 193, 96, 0.22) 0%, transparent 65%);
  filter: blur(30px);
  pointer-events: none;
}

.hero-body {
  position: relative;
  z-index: 1;
  padding: 56rpx 40rpx 44rpx;
  text-align: center;
}

/* 等级标签 */
.level-tag {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 22rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.07);
  margin-bottom: 44rpx;
}

.level-mark {
  font-size: 22rpx;
  color: #07C160;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.level-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 大数字 */
.figure {
  margin-bottom: 40rpx;
}

.figure-num {
  display: block;
  font-size: 120rpx;
  font-weight: 200;
  color: #fff;
  line-height: 1;
  letter-spacing: -4rpx;
}

.figure-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

/* 百分位 */
.percentile {
  margin-bottom: 8rpx;
}

.percentile-head {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.percentile-num {
  font-size: 40rpx;
  font-weight: 300;
  color: #07C160;
}

.percentile-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
}

.percentile-track {
  height: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 2rpx;
  margin: 0 60rpx;
  overflow: hidden;
}

.percentile-fill {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #2ECC71);
  border-radius: 2rpx;
  transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.rank {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.2);
  margin-top: 18rpx;
  letter-spacing: 2rpx;
}

/* 数据条 */
.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.hs-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.hs-num {
  font-size: 36rpx;
  font-weight: 300;
  color: #fff;
}

.hs-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.hs-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.06);
}

/* ── 通用区块 ── */
.section {
  padding: 40rpx;
  animation: rise 0.5s ease both;
}

.section:nth-of-type(1) { animation-delay: 0.08s; }
.section:nth-of-type(2) { animation-delay: 0.16s; }

@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 28rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1C;
  letter-spacing: 1rpx;
}

.sec-sub {
  font-size: 24rpx;
  color: #999;
}

/* ── 等级进度 ── */
.lv-track {
  height: 6rpx;
  background: #EAEAEA;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.lv-fill {
  height: 100%;
  background: #07C160;
  border-radius: 3rpx;
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.lv-foot {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

/* ── 徽章 ── */
.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.badge {
  width: calc((100% - 32rpx) / 3);
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 22rpx;
  border-radius: 14rpx;
  background: #fff;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.badge.is-locked {
  filter: grayscale(1);
  opacity: 0.35;
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #07C160;
  flex-shrink: 0;
  box-shadow: 0 0 12rpx rgba(7, 193, 96, 0.4);
  transition: all 0.3s ease;
}

.badge.is-locked .badge-dot {
  background: #CCC;
  box-shadow: none;
}

.badge-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.badge-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.badge-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ── 分享按钮 ── */
.share-btn {
  margin: 0 40rpx 40rpx;
  background: #1A1A1C;
  color: #fff;
  border-radius: 100rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  animation: rise 0.5s ease 0.24s both;
  transition: all 0.2s ease;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  opacity: 0.75;
  transform: scale(0.97);
}

/* ── 底部 ── */
.footer {
  padding: 20rpx 40rpx 80rpx;
  text-align: center;
  animation: rise 0.5s ease 0.32s both;
}

.footer text {
  font-size: 22rpx;
  color: #BBB;
  line-height: 1.9;
  letter-spacing: 1rpx;
}
