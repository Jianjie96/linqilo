.page-leaderboard {
  padding: 0 0 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 主成就卡片 */
.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 0 0 32rpx 32rpx;
  padding: 40rpx 30rpx 50rpx;
  text-align: center;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #07C160 0%, #0FAE5E 40%, #1B8E50 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-level {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 30rpx;
}

.level-icon {
  font-size: 32rpx;
}

.level-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.hero-number {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.hero-count {
  font-size: 96rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.1;
}

.hero-unit {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.hero-desc {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 30rpx;
}

.hero-percentile {
  margin-top: 10rpx;
}

.percentile-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  display: block;
  margin-bottom: 16rpx;
}

.percentile-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 60rpx;
}

.percentile-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.8s ease;
}

.hero-rank {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 分享按钮 */
.share-btn {
  margin: 24rpx 30rpx;
  background: #fff;
  border: 2rpx solid #07C160;
  color: #07C160;
  border-radius: 16rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 32rpx;
}

/* 数据概览 */
.stats-overview {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 等级进度 */
.level-section {
  margin: 0 30rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.section-sub {
  font-size: 24rpx;
  color: #999;
}

.level-progress-bar {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.level-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #0FAE5E);
  border-radius: 8rpx;
  transition: width 0.8s ease;
}

.level-progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

/* 成就徽章 */
.badges-section {
  margin: 0 30rpx 24rpx;
}

.badges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.badge-item {
  width: calc(33.33% - 14rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  border: 2rpx solid transparent;
}

.badge-item.locked {
  opacity: 0.45;
}

.badge-item.locked .badge-icon {
  filter: grayscale(1);
}

.badge-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.badge-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.badge-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.4;
}

/* 鼓励语 */
.encouragement {
  padding: 30rpx;
  text-align: center;
}

.encourage-text {
  font-size: 26rpx;
  color: #BBB;
  line-height: 1.8;
}
