<view class="page-leaderboard">
  <!-- 加载 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <text class="loading-text">统计中</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 主成就区 -->
    <view class="hero">
      <view class="hero-glow"></view>
      <view class="hero-body">
        <view class="level-tag">
          <text class="level-mark">Lv.{{levelInfo.mark}}</text>
          <text class="level-name">{{levelInfo.name}}</text>
        </view>

        <view class="figure">
          <text class="figure-num">{{stats.totalSaved}}</text>
          <text class="figure-label">件物品已避免过期</text>
        </view>

        <view class="percentile" wx:if="{{stats.totalUsers > 0}}">
          <view class="percentile-head">
            <text class="percentile-num">{{stats.percentile}}%</text>
            <text class="percentile-desc">超过的用户</text>
          </view>
          <view class="percentile-track">
            <view class="percentile-fill" style="width: {{stats.percentile}}%"></view>
          </view>
          <text class="rank" wx:if="{{stats.totalSaved > 0}}">#{{stats.rank}} / {{stats.totalUsers}}</text>
        </view>
      </view>

      <!-- 数据条 -->
      <view class="hero-stats">
        <view class="hs-cell">
          <text class="hs-num">{{stats.totalTracked}}</text>
          <text class="hs-label">累计追踪</text>
        </view>
        <view class="hs-divider"></view>
        <view class="hs-cell">
          <text class="hs-num">{{stats.totalSaved}}</text>
          <text class="hs-label">避免过期</text>
        </view>
        <view class="hs-divider"></view>
        <view class="hs-cell">
          <text class="hs-num">{{saveRate}}%</text>
          <text class="hs-label">守护率</text>
        </view>
      </view>
    </view>

    <!-- 等级进度 -->
    <view class="section">
      <view class="sec-head">
        <text class="sec-title">等级进度</text>
        <text class="sec-sub">{{levelInfo.name}}</text>
      </view>
      <view class="lv-track">
        <view class="lv-fill" style="width: {{levelProgress}}%"></view>
      </view>
      <view class="lv-foot">
        <text>{{stats.totalSaved}} / {{levelInfo.nextThreshold}}</text>
        <text wx:if="{{!levelInfo.isMax}}">还需 {{levelInfo.remaining}} 件升至 {{levelInfo.nextName}}</text>
        <text wx:else>已达最高等级</text>
      </view>
    </view>

    <!-- 徽章 -->
    <view class="section">
      <view class="sec-head">
        <text class="sec-title">成就徽章</text>
        <text class="sec-sub">{{earnedBadges}} / {{badges.length}}</text>
      </view>
      <view class="badge-grid">
        <view
          wx:for="{{badges}}"
          wx:key="id"
          class="badge {{item.earned ? 'is-earned' : 'is-locked'}}"
        >
          <view class="badge-dot"></view>
          <view class="badge-text">
            <text class="badge-name">{{item.name}}</text>
            <text class="badge-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分享 -->
    <button class="share-btn" open-type="share">分享给好友</button>

    <!-- 底部 -->
    <view class="footer">
      <text>{{encourageText}}</text>
    </view>
  </block>
</view>
