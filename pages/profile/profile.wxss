.container {
  padding: 20rpx 30rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 用户信息 */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0 40rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.avatar-btn {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.profile-avatar-default {
  background-color: #F0F0F0;
  background-size: 72rpx 72rpx;
}

.avatar-edit-icon {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.profile-name-wrap {
  margin-top: 24rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  min-width: 200rpx;
  height: 56rpx;
  line-height: 56rpx;
}

/* 设置区域 */
.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 10rpx 16rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.settings-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 通知状态 */
.notify-action {
  text-align: center;
}

.notify-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.notify-status {
  padding: 8rpx 0;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
}

.status-text {
  font-size: 30rpx;
  color: #07C160;
  font-weight: 500;
}

.notify-actions-row {
  display: flex;
  gap: 20rpx;
}

.notify-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.notify-btn::after {
  border: none;
}

.notify-btn-primary {
  background-color: #07C160;
  color: #fff;
}

.notify-btn-primary[disabled] {
  background-color: #9BE4BF;
  color: #fff;
}

.notify-btn-danger {
  background-color: #fff;
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
}

.notify-disabled {
  text-align: center;
  padding: 20rpx 0;
}

.disabled-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.disabled-hint {
  display: block;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 8rpx;
}

/* 设置项 */
.settings-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item-icon {
  width: 34rpx;
  height: 34rpx;
}

.settings-item-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.settings-item-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

.settings-item-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* 带图标的按钮 */
.btn-with-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 底部 */
.settings-footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCC;
}