/* 防止横向溢出（放在 page 上，避免祖先 overflow 破坏 sticky） */
page {
  overflow-x: hidden;
}

.page-index {
  padding-bottom: 160rpx;
  width: 100%;
  box-sizing: border-box;
}

.index-content {
  padding: 0 30rpx;
}

/* ===== 绑定视角标签 ===== */
.binding-tag-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx 0;
}

.binding-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.binding-tag-personal {
  background: #F0F0F0;
  color: #666;
}

.binding-tag-team {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.binding-tag-icon {
  font-size: 24rpx;
}

.binding-tag-text {
  font-size: 24rpx;
}

.binding-tag-hint {
  font-size: 22rpx;
  color: #999;
}

/* ===== 加载骨架屏 ===== */
.loading-block {
  padding: 0 30rpx;
}

.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sk-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sk-card-dark {
  background: #161618;
  padding: 28rpx;
  gap: 14rpx;
}

.sk-line {
  height: 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEEEEE 25%, #F5F5F5 50%, #EEEEEE 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.sk-card-dark .sk-line {
  background: linear-gradient(90deg, rgba(255,255,255,0.06) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.06) 75%);
  background-size: 200% 100%;
}

.sk-line-short { width: 30%; }
.sk-line-mid { width: 55%; }
.sk-line-long { width: 75%; }
.sk-line-full { width: 100%; }
.sk-line-title { width: 45%; height: 20rpx; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx 30rpx;
  margin: -20rpx 0 20rpx;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  width: 100%;
  box-sizing: border-box;
  animation: statsSlideDown 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes statsSlideDown {
  from { opacity: 0; transform: translateY(-24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.stats-content {
  flex: 1;
  display: flex;
  justify-content: space-around;
}

/* ===== 成就卡片 ===== */
.ac-card {
  position: relative;
  overflow: hidden;
  background: #161618;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.ac-card-glow {
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, rgba(7, 193, 96, 0.18) 0%, transparent 70%);
  filter: blur(20px);
  pointer-events: none;
  animation: glowPulse 3s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.ac-card-body {
  position: relative;
  z-index: 1;
  padding: 28rpx 28rpx 24rpx;
}

.ac-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.ac-card-mark {
  font-size: 20rpx;
  color: #07C160;
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 4rpx 14rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 100rpx;
}

.ac-card-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  flex: 1;
}

.ac-card-badges {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.06);
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
}

.ac-card-stats {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.ac-card-stat {
  display: flex;
  flex-direction: column;
}

.ac-card-num {
  font-size: 44rpx;
  font-weight: 200;
  color: #fff;
  line-height: 1.1;
}

.ac-card-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.ac-card-sep {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.06);
}

.ac-card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ac-card-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.ac-card-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-safe .stat-num { color: #07C160; }
.stat-warning .stat-num { color: #FF9500; }
.stat-expired .stat-num { color: #999; }

.stat-sep {
  width: 1rpx;
  height: 48rpx;
  background: #E8E8E8;
}

.stat-value .stat-num {
  color: #333;
  font-size: 36rpx;
}

.stat-saved-stat .stat-num {
  color: #07C160;
}

/* 筛选标签 — sticky 吸顶，类似 web sticky 效果 */
.filter-bar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 50;
  background: #F5F5F5;
  display: flex;
  gap: 16rpx;
  margin: 0 -30rpx 20rpx;
  padding: 8rpx 30rpx;
}

.filter-tag {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #E8E8E8;
  transition: all 0.2s ease;
}

.filter-tag.active {
  background: #07C160;
  color: #fff;
  border-color: #07C160;
  animation: filterPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes filterPop {
  from { transform: scale(0.85); }
  to { transform: scale(1); }
}

/* 物品卡片 */
.item-card {
  position: relative;
  overflow: hidden;
  padding: 0;
  background: #fff;
}

.card-saving-flash {
  animation: savingFlash 0.3s ease;
}

@keyframes savingFlash {
  0% { box-shadow: 0 0 0 0 rgba(7, 193, 96, 0.6); }
  50% { box-shadow: 0 0 0 20rpx rgba(7, 193, 96, 0.15); }
  100% { box-shadow: 0 0 0 0 rgba(7, 193, 96, 0); }
}

.item-inner {
  padding: 30rpx 30rpx 60rpx;
}

/* ===== 左滑删除 ===== */
.swipe-wrapper {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F5F5F5;
}

/* 卡片入场动画 */
.card-rise {
  animation: cardRise 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

@keyframes cardRise {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.swipe-wrapper .item-card {
  margin-bottom: 0;
}

.swipe-save-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 120rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 0 20rpx 20rpx 0;
  z-index: 0;
  animation: savePulse 2s ease-in-out infinite;
}

@keyframes savePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

.swipe-hint {
  position: absolute;
  right: 30rpx;
  bottom: 24rpx;
  pointer-events: none;
}

.swipe-hint-text {
  font-size: 20rpx;
  color: #ccc;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-name-saved {
  text-decoration: line-through;
  color: #999;
}

.item-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-safe {
  background: rgba(7, 193, 96, 0.1);
}

.status-warning {
  background: rgba(255, 149, 0, 0.1);
}

.status-danger {
  background: rgba(255, 59, 48, 0.1);
}

.status-expired {
  background: rgba(153, 153, 153, 0.1);
  color: #999;
}

.status-saved {
  background: linear-gradient(135deg, #4A3F2B 0%, #1C1712 100%);
  color: #F6D98D;
  border: 1rpx solid rgba(246, 217, 141, 0.45);
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 10rpx rgba(28, 23, 18, 0.25);
}

/* 倒计时 */
.countdown-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.countdown-text {
  font-size: 36rpx;
  font-weight: 700;
}

.item-value-tag {
  font-size: 28rpx;
  font-weight: 600;
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.saved-value-tag {
  color: #A87E12;
  background: linear-gradient(135deg, rgba(246, 217, 141, 0.35), rgba(212, 175, 55, 0.12));
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  font-weight: 700;
}

.countdown-saved-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部信息 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-date {
  font-size: 24rpx;
  color: #999;
}

.item-note {
  font-size: 22rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 分类标签配色 */
.item-note.cat-food {
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
}

.item-note.cat-med {
  color: #007AFF;
  background: rgba(0, 122, 255, 0.08);
}

.item-note.cat-cosmetic {
  color: #FF2D55;
  background: rgba(255, 45, 85, 0.08);
}

.item-note.cat-daily {
  color: #FF9500;
  background: rgba(255, 149, 0, 0.08);
}

.item-note.cat-other {
  color: #8E8E93;
  background: rgba(142, 142, 147, 0.1);
}

/* 进度条 */
.progress-bar {
  height: 6rpx;
  background: #F0F0F0;
  border-radius: 3rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.3s;
}

.progress-safe { background: #07C160; }
.progress-warning { background: #FF9500; }
.progress-danger { background: #FF3B30; }
.progress-expired { background: #CCC; }

/* 临期价值提醒 — 可点击省钱 */
.value-reminder {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
}

.value-reminder-icon {
  font-size: 24rpx;
}

.value-reminder-text {
  font-size: 22rpx;
  font-weight: 500;
}

.value-reminder-action {
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.1), rgba(255, 149, 0, 0.04));
  border: 2rpx solid rgba(255, 149, 0, 0.15);
}

.value-reminder-action .value-reminder-text {
  color: #FF9500;
}

.value-reminder-safe {
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.06), rgba(7, 193, 96, 0.02));
  border: 2rpx solid rgba(7, 193, 96, 0.1);
}

.value-reminder-safe .value-reminder-text {
  color: #07C160;
}

.value-reminder-saved {
  background: linear-gradient(135deg, rgba(246, 217, 141, 0.25), rgba(212, 175, 55, 0.08));
  border: 1rpx solid rgba(212, 175, 55, 0.25);
}

.value-reminder-saved .value-reminder-text {
  color: #A87E12;
}

/* 已省钱卡片 */
.swipe-wrapper-saved {
  opacity: 0.8;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 60rpx;
  background: linear-gradient(180deg, rgba(245, 245, 245, 0) 0%, rgba(245, 245, 245, 0.95) 30%, rgba(245, 245, 245, 1) 100%);
  z-index: 100;
}

.bottom-left {
  width: 120rpx;
}

.fab-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.45);
  border: none;
  animation: fabBreathe 3s ease-in-out infinite;
}

@keyframes fabBreathe {
  0%, 100% { transform: scale(1); box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.45); }
  50% { transform: scale(1.04); box-shadow: 0 12rpx 36rpx rgba(7, 193, 96, 0.55); }
}

.fab-pill::after {
  border: none;
}

.fab-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-label {
  font-size: 30rpx;
  line-height: 1;
}

.settings-entry {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 0;
}

.settings-icon {
  font-size: 32rpx;
}

.settings-label {
  font-size: 20rpx;
  color: #999;
}

/* 物品列表（随页面整体滚动，不单独滚动） */
.item-list {
}

/* 分页加载提示 */
.list-footer {
  text-align: center;
  padding: 30rpx 0 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 空状态浮动动画 */
.empty-state {
  animation: emptyFloat 2.5s ease-in-out infinite;
}

@keyframes emptyFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.empty-icon {
  animation: emptyIconBounce 2.5s ease-in-out infinite;
}

@keyframes emptyIconBounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* ===== 🎉 Bingo 庆祝弹层 ===== */
.bingo-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: bingoFadeIn 0.3s ease;
}

@keyframes bingoFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.bingo-card {
  width: 520rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx;
  padding: 64rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: bingoBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bingoBounce {
  from {
    transform: scale(0.3);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.bingo-emoji {
  font-size: 96rpx;
  animation: bingoEmoji 0.6s ease 0.2s both;
}

@keyframes bingoEmoji {
  from {
    transform: scale(0) rotate(-20deg);
    opacity: 0;
  }
  to {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

.bingo-title {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
  animation: bingoFadeUp 0.4s ease 0.4s both;
}

.bingo-amount {
  font-size: 72rpx;
  font-weight: 200;
  color: #07C160;
  margin-top: 12rpx;
  animation: bingoFadeUp 0.4s ease 0.5s both;
}

.bingo-item {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
  max-width: 100%;
  text-align: center;
  word-break: break-all;
  animation: bingoFadeUp 0.4s ease 0.6s both;
}

.bingo-tap {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 32rpx;
  animation: bingoFadeUp 0.4s ease 0.7s both;
}

@keyframes bingoFadeUp {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
