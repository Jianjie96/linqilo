.page-index {
  padding-bottom: 160rpx;
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

.index-content {
  padding: 0 30rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx 30rpx;
  margin: -20rpx 0 20rpx;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  width: 100%;
  box-sizing: border-box;
}

.stats-content {
  flex: 1;
  display: flex;
  justify-content: space-around;
}

/* ===== 成就卡片 ===== */
.achievement-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 52, 96, 0.25);
}

.ac-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ac-level {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ac-level-icon {
  font-size: 44rpx;
}

.ac-level-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFD700;
}

.ac-badge-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.ac-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.ac-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ac-stat-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}

.ac-stat-num.ac-money {
  color: #FFD700;
  font-size: 44rpx;
}

.ac-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 4rpx;
}

.ac-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.15);
}

.ac-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.ac-footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.ac-arrow {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: 6rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-safe .stat-num { color: #07C160; }
.stat-warning .stat-num { color: #FF9500; }
.stat-expired .stat-num { color: #999; }

/* 筛选标签 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-tag {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #E8E8E8;
}

.filter-tag.active {
  background: #07C160;
  color: #fff;
  border-color: #07C160;
}

/* 物品卡片 */
.item-card {
  position: relative;
  overflow: hidden;
  padding: 0;
  background: #fff;
}

.item-inner {
  padding: 30rpx;
}

/* ===== 左滑删除 ===== */
.swipe-wrapper {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F5F5F5;
}

.swipe-wrapper .item-card {
  margin-bottom: 0;
}

.swipe-delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 120rpx;
  background: #FF3B30;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 0 20rpx 20rpx 0;
  z-index: 0;
}

.swipe-hint {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
}

.swipe-hint-text {
  font-size: 20rpx;
  color: #ccc;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-safe {
  background: rgba(7, 193, 96, 0.1);
}

.status-warning {
  background: rgba(255, 149, 0, 0.1);
}

.status-danger {
  background: rgba(255, 59, 48, 0.1);
}

.status-expired {
  background: rgba(153, 153, 153, 0.1);
}

/* 倒计时 */
.countdown-row {
  margin-bottom: 16rpx;
}

.countdown-text {
  font-size: 36rpx;
  font-weight: 700;
}

/* 底部信息 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-date {
  font-size: 24rpx;
  color: #999;
}

.item-note {
  font-size: 22rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 进度条 */
.progress-bar {
  height: 6rpx;
  background: #F0F0F0;
  border-radius: 3rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.3s;
}

.progress-safe { background: #07C160; }
.progress-warning { background: #FF9500; }
.progress-danger { background: #FF3B30; }
.progress-expired { background: #CCC; }

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 60rpx;
  background: linear-gradient(180deg, rgba(245, 245, 245, 0) 0%, rgba(245, 245, 245, 0.95) 30%, rgba(245, 245, 245, 1) 100%);
  z-index: 100;
}

.bottom-left {
  width: 120rpx;
}

.fab-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.45);
  border: none;
}

.fab-pill::after {
  border: none;
}

.fab-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-label {
  font-size: 30rpx;
  line-height: 1;
}

.settings-entry {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 0;
}

.settings-icon {
  font-size: 32rpx;
}

.settings-label {
  font-size: 20rpx;
  color: #999;
}

/* 物品列表 */
.item-list {
  height: calc(100vh - 500rpx);
}
