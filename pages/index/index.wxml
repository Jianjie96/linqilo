<view class="page-index">
  <!-- 自定义页头 -->
  <view class="custom-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-content" style="height: 44px;">
      <!-- 左侧：视角切换 -->
      <view class="header-left" bindtap="toggleSwitcher">
        <view class="header-switch-icon icon {{viewGroupId ? 'icon-users-white' : 'icon-user-white'}}"></view>
        <text class="header-switch-name">{{viewTeamName}}</text>
        <view class="header-switch-arrow icon icon-chevron-down-white {{showSwitcher ? 'arrow-up' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 页头占位符 -->
  <view style="height: {{headerHeight}}px;"></view>

  <!-- 视角切换下拉菜单 -->
  <view class="switcher-overlay" wx:if="{{showSwitcher}}" bindtap="closeSwitcher">
    <view class="switcher-dropdown" style="top: {{headerHeight - 8}}px;" catchtap="">
      <view
        class="switcher-item {{item.isActive ? 'switcher-item-active' : ''}}"
        wx:for="{{switcherOptions}}"
        wx:key="teamId"
        data-team-id="{{item.teamId}}"
        bindtap="onSelectSwitcher"
      >
        <view class="switcher-item-left">
          <view class="switcher-item-icon icon {{item.iconClass}}"></view>
          <text class="switcher-item-name">{{item.name}}</text>
        </view>
        <view class="switcher-item-check icon icon-check-green" wx:if="{{item.isActive}}"></view>
      </view>
      <view class="switcher-divider"></view>
      <view class="switcher-item switcher-manage" bindtap="goTeam">
        <view class="switcher-item-icon icon icon-clipboard-dark"></view>
        <text class="switcher-item-name">队伍管理</text>
      </view>
    </view>
  </view>

  <!-- 顶部统计 -->
  <view class="stats-bar">
    <view class="stats-content">
      <view class="stat-item">
        <text class="stat-num">{{totalCount}}</text>
        <text class="stat-label">全部</text>
      </view>
      <view class="stat-item stat-safe">
        <text class="stat-num">{{safeCount}}</text>
        <text class="stat-label">安全</text>
      </view>
      <view class="stat-item stat-warning">
        <text class="stat-num">{{warningCount}}</text>
        <text class="stat-label">临期</text>
      </view>
      <view class="stat-item stat-expired">
        <text class="stat-num">{{expiredCount}}</text>
        <text class="stat-label">已过期</text>
      </view>
      <view class="stat-item stat-saved-stat">
        <text class="stat-num">{{savedCount}}</text>
        <text class="stat-label">已省钱</text>
      </view>
      <view class="stat-sep"></view>
      <view class="stat-item stat-value">
        <text class="stat-num">¥{{totalValueDisplay}}</text>
        <text class="stat-label">总价值</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-block" wx:if="{{loading}}">
    <view class="loading-skeleton">
      <view class="sk-card sk-card-dark">
        <view class="sk-line sk-line-short"></view>
        <view class="sk-line sk-line-mid"></view>
        <view class="sk-line sk-line-long"></view>
      </view>
      <view class="sk-card">
        <view class="sk-line sk-line-title"></view>
        <view class="sk-line sk-line-mid"></view>
        <view class="sk-line sk-line-long"></view>
        <view class="sk-line sk-line-full"></view>
      </view>
      <view class="sk-card">
        <view class="sk-line sk-line-title"></view>
        <view class="sk-line sk-line-mid"></view>
        <view class="sk-line sk-line-long"></view>
        <view class="sk-line sk-line-full"></view>
      </view>
      <view class="sk-card">
        <view class="sk-line sk-line-title"></view>
        <view class="sk-line sk-line-mid"></view>
        <view class="sk-line sk-line-long"></view>
        <view class="sk-line sk-line-full"></view>
      </view>
    </view>
  </view>

  <view class="index-content" wx:else>
  <!-- 成就卡片 -->
  <view class="ac-card" bindtap="goLeaderboard" wx:if="{{achievementText}}">
    <view class="ac-card-glow"></view>
    <view class="ac-card-body">
      <view class="ac-card-head">
        <text class="ac-card-mark">Lv.{{levelMark}}</text>
        <text class="ac-card-name">{{levelName}}</text>
        <text class="ac-card-badges" wx:if="{{earnedBadges > 0}}">{{earnedBadges}}枚徽章</text>
      </view>
      <view class="ac-card-stats">
        <view class="ac-card-stat">
          <text class="ac-card-num">{{totalSaved}}</text>
          <text class="ac-card-label">件已避免</text>
        </view>
        <view class="ac-card-sep"></view>
        <view class="ac-card-stat">
          <text class="ac-card-num">¥{{estimatedSaved}}</text>
          <text class="ac-card-label">已省下</text>
        </view>
      </view>
      <view class="ac-card-foot" wx:if="{{achievementSub}}">
        <text class="ac-card-sub">{{achievementSub}}</text>
        <view class="ac-card-arrow icon icon-chevron-right-champagne"></view>
      </view>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-bar" style="top: {{headerHeight}}px;">
    <view class="filter-tag {{filterTab === 'all' ? 'active' : ''}}" bindtap="onFilterTab" data-tab="all">全部</view>
    <view class="filter-tag {{filterTab === 'safe' ? 'active' : ''}}" bindtap="onFilterTab" data-tab="safe">安全</view>
    <view class="filter-tag {{filterTab === 'warning' ? 'active' : ''}}" bindtap="onFilterTab" data-tab="warning">临期</view>
    <view class="filter-tag {{filterTab === 'expired' ? 'active' : ''}}" bindtap="onFilterTab" data-tab="expired">已过期</view>
    <view class="filter-tag {{filterTab === 'saved' ? 'active' : ''}}" bindtap="onFilterTab" data-tab="saved">已省钱</view>
  </view>

  <!-- 物品列表 -->
  <view class="item-list" wx:if="{{!isEmpty}}">
    <block wx:for="{{items}}" wx:key="id">
      <view
        wx:if="{{item._visible}}"
        class="swipe-wrapper {{item.saved ? 'swipe-wrapper-saved' : ''}} {{_animateCards ? 'card-rise' : ''}}"
        style="{{_animateCards ? 'animation-delay:' + index * 0.06 + 's;' : ''}}"
      >
        <!-- 背后的省钱按钮（与详情页标记按钮条件一致：未省钱、未过期、有价值） -->
        <view class="swipe-save-btn" wx:if="{{!item.saved && item.status !== 'expired' && item.value > 0}}" data-id="{{item.id}}" catchtap="onSaveItem">
          <text>完成</text>
        </view>

        <!-- 物品卡片（已省钱不可左滑） -->
        <view
          class="item-card card {{item.swiped ? 'swiped' : ''}} {{item._savingFlash ? 'card-saving-flash' : ''}}"
          style="transform: translateX({{item._swipeX || 0}}rpx); transition: {{item._swiping ? 'none' : 'transform 0.3s'}};"
          bindtouchstart="{{(!item.saved && item.status !== 'expired' && item.value > 0) ? 'onTouchStart' : ''}}"
          bindtouchmove="{{(!item.saved && item.status !== 'expired' && item.value > 0) ? 'onTouchMove' : ''}}"
          bindtouchend="{{(!item.saved && item.status !== 'expired' && item.value > 0) ? 'onTouchEnd' : ''}}"
          data-id="{{item.id}}"
        >
          <view class="item-inner" bindtap="goDetail" data-id="{{item.id}}">
            <view class="item-header">
              <view class="item-name {{item.saved ? 'item-name-saved' : ''}}">{{item.name}}</view>
              <view class="item-status status-{{item.saved ? 'saved' : item.status}}">{{item.saved ? '已省钱' : item.statusText}}</view>
            </view>

            <!-- 已省钱状态 -->
            <view class="countdown-row" wx:if="{{item.saved}}">
              <text class="countdown-saved-text">于 {{item.savedAtText}} 使用</text>
              <text class="item-value-tag saved-value-tag" wx:if="{{item.value > 0}}">省 ¥{{item.value}}</text>
            </view>

            <!-- 倒计时（未省钱） -->
            <view class="countdown-row" wx:if="{{!item.saved}}">
              <text class="countdown-text status-{{item.status}}">{{item.countdownText}}</text>
              <text class="item-value-tag" wx:if="{{item.value > 0}}">¥{{item.value}}</text>
            </view>

            <view class="item-footer">
              <text class="item-date">到期：{{item.expiryDate}}</text>
              <text class="item-note {{item.categoryClass}}" wx:if="{{item.category}}">{{item.category}}</text>
            </view>

            <!-- 进度条 -->
            <view class="progress-bar">
              <view class="progress-fill progress-{{item.status}}" style="width: {{item.progressPercent}}%"></view>
            </view>

            <!-- 临期价值提醒 → 可点击省钱 -->
            <view class="value-reminder value-reminder-action" wx:if="{{!item.saved && item.value > 0 && (item.status === 'warning' || item.status === 'danger')}}" catchtap="onSaveItem" data-id="{{item.id}}">
              <text class="value-reminder-text">标记完成，省 ¥{{item.value}}</text>
            </view>

            <!-- 安全期物品的省钱按钮 -->
            <view class="value-reminder value-reminder-action value-reminder-safe" wx:if="{{!item.saved && item.value > 0 && item.status === 'safe'}}" catchtap="onSaveItem" data-id="{{item.id}}">
              <text class="value-reminder-text">标记完成，省 ¥{{item.value}}</text>
            </view>
            <!-- 已省钱庆祝标识 -->
            <view class="value-reminder value-reminder-saved" wx:if="{{item.saved}}">
              <view class="value-reminder-icon icon icon-party-gold"></view>
              <text class="value-reminder-text">已省钱 ¥{{item.value}}</text>
            </view>
          </view>
          <!-- 左滑提示（与详情页标记按钮条件一致：未省钱、未过期、有价值） -->
          <view class="swipe-hint" wx:if="{{!item.saved && item.status !== 'expired' && item.value > 0 && (!item._swipeX || item._swipeX === 0)}}">
            <text class="swipe-hint-text">左滑完成</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 分页加载提示 -->
    <view class="list-footer" wx:if="{{listTotal > 0}}">
      <text wx:if="{{loadingMore}}">加载中...</text>
      <text wx:elif="{{listLoadedAll}}">已显示全部 {{listTotal}} 件</text>
      <text wx:else>上拉加载更多</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty}}">
    <view class="empty-icon icon icon-package-gray"></view>
    <text class="empty-text">还没有物品</text>
    <text class="empty-text">点击下方按钮添加你的第一个物品吧</text>
  </view>

  </view>

  <!-- Bingo 庆祝弹层 -->
  <view class="bingo-overlay" wx:if="{{showBingo}}" bindtap="dismissBingo">
    <view class="bingo-card">
      <view class="bingo-emoji icon icon-party-gold"></view>
      <text class="bingo-title">省下了</text>
      <text class="bingo-amount">¥{{bingoAmount}}</text>
      <text class="bingo-item">{{bingoItemName}}</text>
      <text class="bingo-tap">点击任意处关闭</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-left"></view>
    <button class="fab-pill" bindtap="goAdd">
      <view class="fab-icon icon icon-plus-white"></view>
      <text class="fab-label">添加物品</text>
    </button>
    <view class="settings-entry" bindtap="goSettings">
      <view class="settings-icon icon icon-gear-gray"></view>
      <text class="settings-label">我的</text>
    </view>
  </view>
</view>
