/* 详情头部 */
.detail-header {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin: -20rpx -30rpx 24rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.detail-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
}

.header-safe::before { background: #07C160; }
.header-warning::before { background: #FF9500; }
.header-danger::before { background: #FF3B30; }
.header-expired::before { background: #CCC; }
.header-saved::before { background: #07C160; }

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.detail-name-saved {
  text-decoration: line-through;
  color: #999;
}

.detail-category {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F0F0F0;
  color: #666;
}

/* 大倒计时 */
.big-countdown {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.countdown-number {
  font-size: 120rpx;
  font-weight: 800;
  line-height: 1;
}

.countdown-unit {
  font-size: 30rpx;
  font-weight: 500;
}

/* 进度条 */
.detail-progress {
  margin-top: 20rpx;
}

.progress-bar-lg {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill-lg {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 填充条状态色（与全局 .status-* 色系一致） */
.progress-fill-lg.progress-safe { background: #07C160; }
.progress-fill-lg.progress-warning { background: #FF9500; }
.progress-fill-lg.progress-danger { background: #FF3B30; }
.progress-fill-lg.progress-expired { background: #999; }

.progress-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #BBB;
}

/* 详细信息 */
.detail-info {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value-highlight {
  color: #07C160;
  font-weight: 600;
}

/* 操作按钮 */
.action-buttons {
  padding: 30rpx 0 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-danger {
  background: #fff;
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-danger::after {
  border: none;
}

.btn-save {
  position: relative;
  align-self: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 64rpx;
  line-height: 1.4;
  text-align: center;
  overflow: hidden;
  flex-wrap: nowrap;
  background: linear-gradient(135deg, #2E2518 0%, #4A3F2B 40%, #6B552E 75%, #4A3F2B 100%);
  box-shadow:
    0 6rpx 20rpx rgba(28, 23, 18, 0.4),
    0 0 24rpx rgba(212, 175, 55, 0.22),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.12);
  animation: btnSaveGlow 2.5s ease-in-out infinite;
}

/* 光泽扫过动画 + 清除 button 默认边框 */
.btn-save::after {
  border: none;
  content: '';
  position: absolute;
  top: 0;
  left: -70%;
  width: 45%;
  height: 100%;
  background: linear-gradient(120deg, transparent 0%, rgba(255, 255, 255, 0.14) 50%, transparent 100%);
  transform: skewX(-20deg);
  animation: btnSaveSheen 3.2s ease-in-out infinite;
}

.btn-save-icon {
  display: block;
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 28rpx;
  color: #F6D98D;
}

.btn-save-label {
  display: block;
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #F6D98D;
  background: linear-gradient(180deg, #FBE9BE 0%, #F6D98D 45%, #D4AF37 100%);
  -webkit-background-clip: text;
  background-clip: text;
}

.btn-save-value {
  flex-shrink: 0;
  white-space: nowrap;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 700;
  color: #F6D98D;
  background: linear-gradient(135deg, rgba(246, 217, 141, 0.16), rgba(212, 175, 55, 0.08));
  border: 2rpx solid rgba(246, 217, 141, 0.45);
  border-radius: 30rpx;
  padding: 6rpx 20rpx;
  letter-spacing: 1rpx;
}

.btn-save-hover {
  transform: scale(0.97);
  filter: brightness(1.12);
}

@keyframes btnSaveGlow {
  0%, 100% {
    box-shadow:
      0 6rpx 20rpx rgba(28, 23, 18, 0.4),
      0 0 24rpx rgba(212, 175, 55, 0.22),
      inset 0 2rpx 0 rgba(255, 255, 255, 0.12);
  }
  50% {
    box-shadow:
      0 8rpx 26rpx rgba(28, 23, 18, 0.45),
      0 0 44rpx rgba(212, 175, 55, 0.42),
      inset 0 2rpx 0 rgba(255, 255, 255, 0.12);
  }
}

@keyframes btnSaveSheen {
  0% { left: -70%; }
  55%, 100% { left: 130%; }
}

/* 编辑表单 */
.edit-form {
  margin-bottom: 30rpx;
}

.alert-days-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.alert-day-tag {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #F5F5F5;
  color: #666;
  border: 2rpx solid transparent;
}

.alert-day-tag.active {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-color: #07C160;
}

/* 选择器 */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value .placeholder {
  color: #BBB;
}

.picker-arrow {
  font-size: 24rpx;
  color: #CCC;
}
