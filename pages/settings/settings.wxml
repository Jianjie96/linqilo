<view class="container">
  <!-- 消息通知 -->
  <view class="section-title">临期消息通知</view>
  <view class="card">
    <view class="settings-desc">
      开启后每天早上 8:00 自动检查临期物品，并通过微信服务通知提醒你
    </view>

    <block wx:if="{{cloudEnabled}}">
      <view wx:if="{{!isSubscribed}}" class="notify-action">
        <button class="btn-primary" bindtap="subscribeNotification">🔔 开启临期通知</button>
        <text class="notify-hint">需要授权订阅消息权限</text>
      </view>

      <view wx:if="{{isSubscribed}}" class="notify-status">
        <view class="status-row">
          <text class="status-dot"></text>
          <text class="status-text">通知已开启</text>
        </view>
        <view class="notify-actions-row">
          <button class="notify-btn notify-btn-primary" disabled="{{isSyncing}}" bindtap="manualSync">{{isSyncing ? '同步中...' : '立即同步数据'}}</button>
          <button class="notify-btn notify-btn-danger" bindtap="unsubscribeNotification">关闭通知</button>
        </view>
      </view>
    </block>

    <block wx:if="{{!cloudEnabled}}">
      <view class="notify-disabled">
        <text class="disabled-text">云开发未启用，通知功能不可用</text>
        <text class="disabled-hint">请先在微信开发者工具中开通云开发</text>
      </view>
    </block>
  </view>

  <!-- 数据管理 -->
  <view class="section-title">数据管理</view>
  <view class="card">
    <view class="settings-item" bindtap="exportData">
      <text class="settings-item-label">📋 导出数据</text>
      <text class="settings-item-value">{{totalItems}} 条记录</text>
      <text class="settings-item-arrow">›</text>
    </view>
    <view class="settings-item" bindtap="clearAllData">
      <text class="settings-item-label">🗑️ 清除所有数据</text>
      <text class="settings-item-arrow">›</text>
    </view>
  </view>

  <!-- 组队管理 -->
  <view class="section-title">组队共享</view>
  <view class="card">
    <view class="settings-item" bindtap="goTeam">
      <text class="settings-item-label">👥 队伍管理</text>
      <text class="settings-item-value">{{boundTeamName}}</text>
      <text class="settings-item-arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section-title">关于</view>
  <view class="card">
    <view class="settings-item" bindtap="goHelp">
      <text class="settings-item-label">📖 使用帮助</text>
      <text class="settings-item-arrow">›</text>
    </view>
    <view class="settings-item" bindtap="showAbout">
      <text class="settings-item-label">关于「叮咚到期」</text>
      <text class="settings-item-value">v{{aboutInfo.version}}</text>
      <text class="settings-item-arrow">›</text>
    </view>
  </view>

  <!-- 底部 -->
  <view class="settings-footer">
    <text class="footer-text">叮咚到期 · 提前记录，临期提醒，重要事情不再忘</text>
  </view>
</view>
