.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 10rpx 16rpx;
  font-weight: 500;
}

.settings-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 通知状态 */
.notify-action {
  text-align: center;
}

.notify-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.notify-status {
  padding: 8rpx 0;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
}

.status-text {
  font-size: 30rpx;
  color: #07C160;
  font-weight: 500;
}

.notify-actions-row {
  display: flex;
  gap: 20rpx;
}

.notify-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.notify-btn::after {
  border: none;
}

.notify-btn-primary {
  background-color: #07C160;
  color: #fff;
}

.notify-btn-primary[disabled] {
  background-color: #9BE4BF;
  color: #fff;
}

.notify-btn-danger {
  background-color: #fff;
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
}

.notify-disabled {
  text-align: center;
  padding: 20rpx 0;
}

.disabled-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.disabled-hint {
  display: block;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 8rpx;
}

/* 设置项 */
.settings-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item-icon {
  width: 34rpx;
  height: 34rpx;
}

.settings-item-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.settings-item-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

.settings-item-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* 带图标的按钮 */
.btn-with-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 底部 */
.settings-footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCC;
}
