.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 10rpx 16rpx;
  font-weight: 500;
}

.settings-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 通知状态 */
.notify-action {
  text-align: center;
}

.notify-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.notify-status {
  padding: 8rpx 0;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
}

.status-text {
  font-size: 30rpx;
  color: #07C160;
  font-weight: 500;
}

.notify-actions-row {
  display: flex;
  gap: 24rpx;
}

.link-btn {
  font-size: 26rpx;
  color: #07C160;
  padding: 8rpx 0;
}

.link-danger {
  color: #FF3B30;
}

.notify-disabled {
  text-align: center;
  padding: 20rpx 0;
}

.disabled-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.disabled-hint {
  display: block;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 8rpx;
}

/* 设置项 */
.settings-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.settings-item-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

.settings-item-arrow {
  font-size: 36rpx;
  color: #CCC;
}

/* 底部 */
.settings-footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCC;
}
